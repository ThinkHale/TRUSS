# ── TRUSS environment ────────────────────────────────────────────────────────
# Copy to .env.local for development. Never commit real values.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API. The anon key is safe in the browser because Row Level
# Security enforces tenant isolation in the database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Bypasses RLS — used by the Stripe webhook and knowledge
# ingestion, which run without a user session. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Powers TRUSS Coach, voice roleplay, scoring, research, and campaigns.
OPENAI_API_KEY=sk-...

# Optional overrides. Defaults are set in src/lib/ai/openai.ts.
# OPENAI_MODEL_COACH=gpt-4.1
# OPENAI_MODEL_STRUCTURED=gpt-4.1
# OPENAI_MODEL_REALTIME=gpt-4o-realtime-preview
# OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe
# OPENAI_MODEL_SPEECH=gpt-4o-mini-tts
# OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# ── Google Maps Platform ─────────────────────────────────────────────────────
# One key, with these APIs enabled:
#   Geocoding API, Places API (New), Weather API
# Server-side only, so restrict it by API rather than by HTTP referrer.
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── NOAA / National Weather Service ──────────────────────────────────────────
# Keyless and free, but api.weather.gov asks for a contact in the User-Agent.
NWS_USER_AGENT=TRUSS (trusscoach.com; support@trusscoach.com)

# ── Stripe (subscription plans) ──────────────────────────────────────────────
# Optional. Without these the app runs, but upgrades are unavailable and
# every org stays on the free plan.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
